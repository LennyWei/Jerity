{
  "name": "bumper-brawl",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "sim": "node server/sim.js",
    "fake": "node server/fake.js",
    "fake:client": "node server/fake-client.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "dev:phone": "vite --config client/vite.config.js --mode phone"
  },
  "dependencies": {
    "express": "^4.21.0",
    "planck": "^1.4.2",
    "qrcode": "1.5.4",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "socket.io-client": "^4.8.0",
    "vite": "^8.3.5"
  }
}
